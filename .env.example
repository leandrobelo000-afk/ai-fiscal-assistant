# .env.example — Copie para .env e ajuste conforme necessário
# ─────────────────────────────────────────────────────────────

# LM Studio / LLM Local
LM_STUDIO_URL=http://localhost:1234/v1/chat/completions
LM_STUDIO_MODELS_URL=http://localhost:1234/v1/models
MODELO_VISAO=qwen2.5-vl-3b-instruct
MODELO_CHAT=qwen2.5-vl-3b-instruct
TEMPERATURA=0.1
MAX_TOKENS_VISAO=2048
MAX_TOKENS_CHAT=1024

# Tesseract OCR (opcional - só defina se NÃO estiver no PATH do sistema)
# Windows: TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux:   TESSERACT_CMD=/usr/bin/tesseract
# macOS:   TESSERACT_CMD=/opt/homebrew/bin/tesseract
# TESSERACT_CMD=

# Planilha / Banco de Dados
CAMINHO_PLANILHA=notas_fiscais.xlsx
# Futuro (SQLite): DATABASE_URL=sqlite:///notas_fiscais.db

# Interface Streamlit
STREAMLIT_PORT=8501
STREAMLIT_THEME=light